# Paperlane configuration — copy to .env, adjust, and load it (e.g. `set -a; source .env; set +a`) before starting.
# Every value is optional for local development.

# --- Core -------------------------------------------------------------------------------------------
PAPERLANE_SECRET_KEY=change-me-to-a-long-random-string      # required in production
PAPERLANE_DEBUG=1                                           # 0 in production
PAPERLANE_ALLOWED_HOSTS=localhost,127.0.0.1                 # comma separated
PAPERLANE_SITE_URL=http://127.0.0.1:8000                    # used for links in emails
PAPERLANE_TIME_ZONE=America/Port_of_Spain

# --- Email ------------------------------------------------------------------------------------------
PAPERLANE_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
PAPERLANE_FROM_EMAIL=Paperlane <no-reply@example.com>
PAPERLANE_EMAIL_HOST=smtp.example.com     # used with the smtp backend
PAPERLANE_EMAIL_PORT=587
PAPERLANE_EMAIL_USER=
PAPERLANE_EMAIL_PASSWORD=
PAPERLANE_EMAIL_TLS=1

# --- HTTPS (production) ---------------------------------------------------------------------------------
PAPERLANE_HTTPS=0                   # 1 = secure cookies, HSTS, HTTPS redirect, trusted proxy header
PAPERLANE_HSTS_SECONDS=31536000

# --- Background jobs (reminders, deadlines, delayed bots, scheduled starts, webhook retries) -----------
PAPERLANE_SCHEDULER=1               # 1 = run inside the web process; 0 = run `manage.py paperlane_tick --loop 30` separately
PAPERLANE_SCHEDULER_SECONDS=30

# --- AI (all optional; the built-in planner works without any of these) ------------------------------
OLLAMA_HOST=http://127.0.0.1:11434 # local models, auto-discovered
PAPERLANE_OLLAMA_MODELS=            # comma list to limit which Ollama models are offered
PAPERLANE_AI_ENGINE=                # default engine id, e.g. ollama:qwen3.5:9b
PAPERLANE_AI_TIMEOUT=300            # seconds to wait for a local model
ANTHROPIC_API_KEY=                 # enables Claude
PAPERLANE_AI_MODEL=                 # Claude model id
PAPERLANE_OPENAI_BASE_URL=          # any OpenAI-compatible server (LM Studio, vLLM, …)
PAPERLANE_OPENAI_API_KEY=

# --- Demo data ----------------------------------------------------------------------------------------
PAPERLANE_DEMO_PASSWORD=paperlane-demo-2026

# --- Production database, cache and backups --------------------------------------------------------------
PAPERLANE_DATABASE_URL=                 # e.g. postgres://paperlane:secret@db:5432/paperlane (blank = db.sqlite3)
PAPERLANE_CACHE=                        # db (default when PAPERLANE_DEBUG=0; run `manage.py createcachetable`) or memory
PAPERLANE_BACKUP_DIR=./backups
PAPERLANE_BACKUP_KEEP=14
POSTGRES_PASSWORD=                     # docker-compose only
PAPERLANE_DOMAIN=                       # docker-compose + Caddy: the public domain, e.g. docs.example.com
PAPERLANE_ACME_EMAIL=                   # contact address for the HTTPS certificate
COMPOSE_PROFILES=https                 # start Caddy; blank when you bring your own TLS proxy
PAPERLANE_BIND=127.0.0.1                # where the web container's port is published (0.0.0.0 = every interface)
PAPERLANE_BACKUP_AT=02:30               # nightly backup time in the worker
PAPERLANE_LOG_LEVEL=INFO

# --- Payments on start forms (optional, Stripe Checkout) --------------------------------------------------
PAPERLANE_STRIPE_SECRET_KEY=          # sk_test_… or sk_live_…
PAPERLANE_STRIPE_WEBHOOK_SECRET=      # whsec_… — webhook URL: <site>/payments/stripe/webhook/ (checkout.session.completed)

# --- Uploaded files on S3-compatible storage (optional; default: the local media volume) ---
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces. Links are signed and expire.
#PAPERLANE_S3_BUCKET=paperlane-files
#PAPERLANE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # leave empty for AWS
#PAPERLANE_S3_REGION=auto
#PAPERLANE_S3_ACCESS_KEY=
#PAPERLANE_S3_SECRET_KEY=
#PAPERLANE_S3_PREFIX=                 # optional folder inside the bucket
#PAPERLANE_S3_LINK_SECONDS=3600

# --- Error reporting (optional): Sentry or a compatible service such as GlitchTip ---
#PAPERLANE_SENTRY_DSN=
#PAPERLANE_SENTRY_TRACES=0            # 0.1 = performance traces for 10% of requests
#PAPERLANE_ENVIRONMENT=production

# --- Cloud drives for the "Save to cloud drive" bot (optional) ---
# Register an OAuth app; redirect URI: <PAPERLANE_SITE_URL>/account/connections/oauth/google/callback/ (or .../microsoft/...)
#PAPERLANE_GOOGLE_CLIENT_ID=
#PAPERLANE_GOOGLE_CLIENT_SECRET=
#PAPERLANE_MS_CLIENT_ID=
#PAPERLANE_MS_CLIENT_SECRET=
#PAPERLANE_MS_TENANT=common          # or your tenant id, to allow only your organisation
# LibreOffice turns Word templates into PDF; set its path if it isn't on PATH
#PAPERLANE_SOFFICE=/usr/bin/soffice
